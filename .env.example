# Copia este fichero como .env y rellena tus valores. No subas el .env real a git.

# Credenciales de acceso a /admin (HTTP Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esto

# API key gratuita de https://www.football-data.org/client/register
# Necesaria solo para los botones de "sincronizar" resultados/equipos.
FOOTBALL_DATA_API_KEY=

# Ruta del fichero SQLite (opcional, por defecto porra.db en la raíz del proyecto)
# DATABASE_PATH=porra.db
